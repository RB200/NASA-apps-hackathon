{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5173",
        "--directory",
        "frontend"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": [
        "app:app",
        "--app-dir",
        "backend",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000,
      "autoPort": false
    }
  ]
}